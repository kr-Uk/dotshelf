# 개발 시 MSW(Mock Service Worker) 활성화. 운영 빌드에선 미설정 또는 false.
# `.env.local`로 복사 후 사용.
NEXT_PUBLIC_USE_MOCKS=true

# 사업자 정보 / 민원 담당자 / 환금성 책임 문구
# (KG이니시스 충전업종 사전 심사 — 사이트 하단 상점정보 표기 + 사업자 정보 페이지 노출용)
# 실값 확보 전까지는 빈 문자열로 두고 빌드 가능. 빈 값은 페이지에 "(설정 전)" 으로 렌더링.
# Phase 2 에서 BE 정책 API (`GET /v1/payments/policy`) 호출로 전환 예정.
NEXT_PUBLIC_MERCHANT_NAME=
NEXT_PUBLIC_MERCHANT_REGISTRATION_NUMBER=
NEXT_PUBLIC_MERCHANT_REPRESENTATIVE=
NEXT_PUBLIC_MERCHANT_ADDRESS=
NEXT_PUBLIC_MERCHANT_TEL=
NEXT_PUBLIC_MERCHANT_EMAIL=
NEXT_PUBLIC_MERCHANT_MAIL_ORDER_REGISTRATION_NUMBER=
NEXT_PUBLIC_COMPLAINT_CONTACT_NAME=
NEXT_PUBLIC_COMPLAINT_CONTACT_TEL=
# 환금성 책임 문구. 미설정 시 기본 문구 사용.
NEXT_PUBLIC_RESPONSIBILITY_NOTICE=
