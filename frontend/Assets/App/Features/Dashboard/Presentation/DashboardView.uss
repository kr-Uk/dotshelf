.dashboard-root {
    flex-grow: 1;
    background-color: rgb(248, 245, 240);
    padding: 24px;
    flex-direction: column;
}

.dashboard-body {
    flex-direction: row;
    flex-grow: 1;
    margin-bottom: 16px;
}

.dashboard-pane {
    background-color: rgba(255, 255, 255, 0.85);
    border-radius: 12px;
    padding: 16px;
}

.left-pane {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 12px;
}

.right-pane {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 12px;
}

.profile-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
    flex-shrink: 0;
}

.profile-image {
    width: 72px;
    height: 72px;
    border-radius: 36px;
    background-color: rgb(220, 220, 220);
    margin-right: 16px;
}

.profile-text-block {
    flex-grow: 1;
}

.profile-top-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.nickname-label {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(40, 40, 40);
    margin-right: 12px;
}

.follow-stats {
    flex-direction: row;
    flex-grow: 1;
}

.follow-stat {
    margin-right: 12px;
    font-size: 12px;
    color: rgb(110, 110, 110);
}

.like-toggle-button {
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0 6px 0 0;
    font-size: 16px;
    color: rgb(180, 130, 130);
    min-width: auto;
    min-height: auto;
}

.like-toggle-button.liked {
    color: rgb(220, 60, 60);
    -unity-font-style: bold;
}

.like-toggle-button.read-only {
    color: rgb(180, 130, 130);
}

.like-toggle-button.read-only:hover {
    color: rgb(180, 130, 130);
    background-color: transparent;
}

.like-toggle-button:hover {
    color: rgb(220, 60, 60);
}

.introduction-label {
    font-size: 13px;
    color: rgb(80, 80, 80);
    white-space: normal;
}

.stats-row {
    flex-direction: row;
    background-color: rgba(255, 255, 255, 0.7);
    border-radius: 10px;
    padding: 12px 8px;
    margin-bottom: 16px;
    flex-shrink: 0;
    height: 50px;
}

.stat-cell {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.stat-icon {
    font-size: 16px;
    margin-right: 6px;
    color: rgb(120, 100, 100);
}

.stat-value {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(60, 60, 60);
}

.section-card {
    background-color: rgba(255, 255, 255, 0.7);
    border-radius: 10px;
    padding: 12px;
    margin-bottom: 12px;
    flex-direction: column;
    flex-shrink: 0;
}

.section-card-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    flex-shrink: 0;
    min-height: 24px;
}

.section-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(60, 60, 60);
}

.section-view-all {
    font-size: 11px;
    background-color: transparent;
    border-width: 0;
    color: rgb(120, 120, 120);
}

.carousel-row {
    flex-direction: row;
    flex-wrap: nowrap;
    overflow: hidden;
    height: 110px;
}

.carousel-scroll {
    height: 150px;
    min-height: 150px;
    max-height: 150px;
}

.carousel-scroll .unity-scroll-view__content-container {
    flex-direction: row;
}

.carousel-cell {
    width: 84px;
    margin-right: 8px;
    flex-shrink: 0;
}

.book-cover {
    width: 80px;
    height: 110px;
    background-color: rgb(200, 180, 160);
    border-radius: 4px;
}

.book-cell-title {
    font-size: 10px;
    color: rgb(80, 80, 80);
    margin-top: 4px;
    white-space: normal;
    overflow: hidden;
}

.record-cell {
    width: 200px;
    margin-right: 8px;
    background-color: rgb(255, 252, 240);
    border-radius: 6px;
    padding: 8px;
    flex-shrink: 0;
}

.record-cell-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(60, 60, 60);
    margin-bottom: 4px;
}

.record-cell-content {
    font-size: 11px;
    color: rgb(100, 100, 100);
    white-space: normal;
    flex-grow: 1;
    overflow: hidden;
}

.record-cell-meta {
    flex-direction: row;
    margin-top: 4px;
}

.record-cell-meta-item {
    font-size: 10px;
    color: rgb(140, 140, 140);
    margin-right: 8px;
}

.guestbook-header {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 12px;
}

.guestbook-count {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(60, 60, 60);
}

.weekly-visitor {
    font-size: 12px;
    color: rgb(120, 120, 120);
}

.guestbook-grid {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
    align-content: flex-start;
}

.guestbook-cell {
    width: 19%;
    height: 32%;
    margin: 0.5%;
    background-color: rgb(255, 245, 200);
    border-radius: 6px;
    padding: 8px;
    rotate: -1deg;
}

.guestbook-cell:hover {
    rotate: 0;
    background-color: rgb(255, 250, 220);
}

.guestbook-cell-content {
    font-size: 11px;
    color: rgb(60, 60, 60);
    white-space: normal;
    flex-grow: 1;
    overflow: hidden;
}

.guestbook-cell-reply {
    font-size: 10px;
    color: rgb(100, 80, 80);
    -unity-font-style: italic;
    margin-top: 4px;
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.1);
    padding-top: 4px;
}

.guestbook-cell-nickname {
    font-size: 9px;
    color: rgb(120, 120, 120);
    margin-top: 4px;
    -unity-text-align: middle-right;
}

.guestbook-pagination {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 8px;
}

.page-button {
    width: 32px;
    height: 28px;
    margin: 0 8px;
    font-size: 12px;
    background-color: rgba(255, 255, 255, 0.5);
    border-radius: 4px;
}

.page-button:disabled {
    opacity: 0.4;
}

.page-label {
    font-size: 12px;
    color: rgb(80, 80, 80);
    min-width: 30px;
    -unity-text-align: middle-center;
}

.bottom-action-bar {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    height: 56px;
}

.bottom-action-button {
    min-width: 140px;
    height: 40px;
    font-size: 14px;
    -unity-font-style: bold;
    border-radius: 20px;
    margin: 0 6px;
}

.edit-button {
    background-color: rgb(120, 160, 200);
    color: white;
}

.write-button {
    background-color: rgb(180, 140, 100);
    color: white;
}

.hidden {
    display: none;
}
