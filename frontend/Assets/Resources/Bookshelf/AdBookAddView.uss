/* ============================================================================
   광고책 추가 overlay (책장 선택) — "Card Catalog" 디자인.
   디자인 토큰(공용): Resources/UI/DotshelfDesignTokens.uss 의 var(--ds-*).
   셀렉터 prefix shelf-ad-* 로 분리 — 다른 overlay USS 와 광역 충돌 없음.
   ============================================================================ */

/* ----- Modal layer ----- */

.shelf-ad-root {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
}

.hidden { display: none; }

.shelf-ad-backdrop {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: var(--ds-color-overlay-scrim);
}

.shelf-ad-frame {
    width: var(--ds-modal-width-sm);
    max-width: 92%;
    max-height: 86%;
    background-color: var(--ds-color-paper);
    border-radius: var(--ds-radius-md);
    border-width: var(--ds-border-hairline);
    border-color: var(--ds-color-rule);
    padding-top: var(--ds-space-7);
    padding-bottom: var(--ds-space-6);
    padding-left: var(--ds-space-8);
    padding-right: var(--ds-space-8);
    flex-direction: column;
}

/* ----- Header ----- */

.shelf-ad-header {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: var(--ds-space-4);
    flex-shrink: 0;
}

.shelf-ad-header-text {
    flex-direction: column;
    flex-grow: 1;
}

.shelf-ad-eyebrow {
    font-size: var(--ds-font-eyebrow);
    color: var(--ds-color-ink-faint);
    letter-spacing: var(--ds-track-display);
    -unity-font-style: bold;
    margin-bottom: var(--ds-space-1);
}

.shelf-ad-title {
    font-size: var(--ds-font-hero);
    -unity-font-style: bold;
    color: var(--ds-color-ink);
}

.shelf-ad-close-button {
    background-color: rgba(0, 0, 0, 0);
    color: var(--ds-color-ink-soft);
    font-size: var(--ds-font-headline);
    width: 38px;
    height: 38px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    border-radius: var(--ds-radius-sm);
    border-width: var(--ds-border-hairline);
    border-color: var(--ds-color-rule);
    transition-property: background-color, color;
    transition-duration: var(--ds-motion-fast);
}

.shelf-ad-close-button:hover {
    background-color: var(--ds-color-ink);
    color: var(--ds-color-ink-on-stamp);
}

.shelf-ad-close-button:active {
    scale: 0.96 0.96;
}

/* ----- Rule ----- */

.shelf-ad-rule {
    height: 1px;
    background-color: var(--ds-color-ink);
    margin-bottom: var(--ds-space-4);
    flex-shrink: 0;
}

/* ----- Body ----- */

.shelf-ad-body {
    flex-direction: column;
}

.shelf-ad-hint {
    font-size: var(--ds-font-body);
    color: var(--ds-color-ink-soft);
    letter-spacing: var(--ds-track-loose);
    margin-bottom: var(--ds-space-4);
    white-space: normal;
}

/* ----- Shelf list ----- */

.shelf-ad-list {
    flex-grow: 1;
    min-height: 120px;
    max-height: 300px;
    margin-bottom: var(--ds-space-3);
}

.shelf-ad-shelf-row {
    flex-direction: row;
    align-items: center;
    background-color: var(--ds-color-paper-soft);
    border-radius: var(--ds-radius-xs);
    border-left-width: var(--ds-border-extra);
    border-left-color: rgba(0, 0, 0, 0);
    border-top-width: var(--ds-border-hairline);
    border-right-width: var(--ds-border-hairline);
    border-bottom-width: var(--ds-border-hairline);
    border-top-color: var(--ds-color-rule-mute);
    border-right-color: var(--ds-color-rule-mute);
    border-bottom-color: var(--ds-color-rule-mute);
    padding-top: var(--ds-space-3);
    padding-bottom: var(--ds-space-3);
    padding-left: var(--ds-space-4);
    padding-right: var(--ds-space-4);
    margin-top: 0;
    margin-bottom: 6px;
    margin-left: 0;
    margin-right: 0;
    transition-property: background-color, border-left-color, translate;
    transition-duration: var(--ds-motion-base);
}

.shelf-ad-shelf-row:hover {
    background-color: var(--ds-color-paper-warm);
    border-left-color: var(--ds-color-stamp);
    translate: 2px 0;
}

.shelf-ad-shelf-row:active {
    scale: 0.99 0.99;
}

.shelf-ad-shelf-row:disabled {
    opacity: var(--ds-opacity-muted);
}

.shelf-ad-shelf-name {
    flex-grow: 1;
    font-size: var(--ds-font-list);
    color: var(--ds-color-ink);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.shelf-ad-shelf-arrow {
    font-size: var(--ds-font-body-strong);
    color: var(--ds-color-ink-faint);
    margin-left: var(--ds-space-3);
}

/* ----- Status ----- */

.shelf-ad-status {
    font-size: var(--ds-font-body);
    color: var(--ds-color-ink-soft);
    letter-spacing: var(--ds-track-loose);
    flex-shrink: 0;
    white-space: normal;
}

.shelf-ad-empty {
    font-size: var(--ds-font-body);
    color: var(--ds-color-ink-faint);
    -unity-text-align: middle-center;
    padding-top: var(--ds-space-7);
    padding-bottom: var(--ds-space-7);
    white-space: normal;
}
