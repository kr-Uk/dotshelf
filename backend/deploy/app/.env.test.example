# Test 환경용 ENV (SSAFY 호스트의 $EC2_DEPLOY_PATH/.env.test 로 배치, repo 커밋 X).
#
# 사용:
#   docker compose -f docker-compose.test.yml --env-file .env.test up -d --build
#
# prod 와의 차이:
#   - DB:                 dotshelf_test  (별도 database, prod 와 동일 PG instance)
#   - DB_USER:            dotshelf_test_user (test DB 권한만 보유)
#   - SPRING_DATA_REDIS_DATABASE: 1 (prod=0)
#   - JWT_SECRET:         prod 와 다른 값 (토큰 cross-validity 차단)
#   - OAuth 키:           더미값 OK (소셜 로그인 미테스트 정책)

# DB ─ prod PG 의 dotshelf_test database 사용
DB_HOST=100.86.247.88
DB_PORT=5432
DB_NAME=dotshelf_test
DB_USER=dotshelf_test_user
DB_PASSWORD=__FILL_ME__

# Redis ─ prod Redis 공유, database index = 1
REDIS_HOST=100.86.247.88
REDIS_PORT=6379
SPRING_DATA_REDIS_DATABASE=1

# JWT ─ prod 와 다른 32+ bytes 값
JWT_SECRET=__FILL_ME_TEST_ONLY_32BYTES_MIN__
JWT_ACCESS_TTL=1800
JWT_REFRESH_TTL=2592000

# OAuth ─ 더미값. 소셜 로그인 흐름 미테스트.
GOOGLE_SERVER_CLIENT_ID=dummy.apps.googleusercontent.com
GOOGLE_CLIENT_ID=dummy.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dummy-secret
GOOGLE_CLIENT_IDS=dummy.apps.googleusercontent.com
KAKAO_REST_API_KEY=dummy
KAKAO_CLIENT_SECRET=dummy
KAKAO_REDIRECT_URI=http://localhost:18080/oauth/kakao/callback
APPLE_CLIENT_ID=dummy
APPLE_CLIENT_IDS=dummy
