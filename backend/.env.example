# DotShelf Backend local environment example
# Copy this file to `.env.local` and fill real values.
# Do not commit `.env.local`.

# JWT
JWT_SECRET=change-me-to-at-least-32-bytes-secret
JWT_ACCESS_TTL=1800
JWT_REFRESH_TTL=2592000

# Google OAuth
# Web OAuth Client ID. Used as the server client id and the default Google audience.
GOOGLE_SERVER_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-web-oauth-client-secret

# All Google OAuth Client IDs that BE should accept in id_token aud.
# Include Web, Android, Desktop, and iOS client IDs if each platform can issue id_token directly.
GOOGLE_CLIENT_IDS=your-web-oauth-client-id.apps.googleusercontent.com,your-android-oauth-client-id.apps.googleusercontent.com,your-desktop-oauth-client-id.apps.googleusercontent.com,your-ios-oauth-client-id.apps.googleusercontent.com

# Platform-specific references for Unity/client setup. Backend does not read these directly.
GOOGLE_ANDROID_CLIENT_ID=your-android-oauth-client-id.apps.googleusercontent.com
GOOGLE_DESKTOP_CLIENT_ID=your-desktop-oauth-client-id.apps.googleusercontent.com
GOOGLE_DESKTOP_CLIENT_SECRET=your-desktop-oauth-client-secret
GOOGLE_IOS_CLIENT_ID=your-ios-oauth-client-id.apps.googleusercontent.com

# Kakao OAuth
# Native app key is used by Android/iOS Unity clients. Backend reads only REST API values.
KAKAO_NATIVE_APP_KEY=your-kakao-native-app-key
KAKAO_REST_API_KEY=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-login-client-secret
# Must exactly match the redirect_uri used by the desktop client when it receives the authorization code.
KAKAO_REDIRECT_URI=http://127.0.0.1:18080/dotshelf/oauth/callback/

# Apple Sign in
APPLE_CLIENT_ID=your-apple-bundle-id-or-services-id
APPLE_CLIENT_IDS=your-apple-bundle-id,your-apple-services-id

# KG Inicis Payments
# Sign key must stay on BE only.
INICIS_MID=INIpayTest
INICIS_SIGN_KEY=your-inicis-web-sign-key
INICIS_RETURN_URL=https://api.example.com/v1/payments/inicis/return
INICIS_CLOSE_URL=https://api.example.com/v1/payments/inicis/close
INICIS_REQUEST_SCRIPT_URL=https://stdpay.inicis.com/stdjs/INIStdPay.js
