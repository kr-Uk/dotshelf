<Window x:Class="DotShelf.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DotShelf 런처"
        Height="660"
        Width="1160"
        Background="Transparent"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStyle="None"
        FontFamily="Pretendard, Pretendard Variable, Spoqa Han Sans Neo, Malgun Gothic, Segoe UI"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp">
    <Window.Resources>

        <!-- ============ Big single CTA (60h, 22r, brand) ============ -->
        <Style x:Key="BigCtaButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandBrush}" />
            <Setter Property="Foreground" Value="{StaticResource OnBrandBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="280" />
            <Setter Property="Height" Value="60" />
            <Setter Property="Padding" Value="28,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="22"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18"
                                                  ShadowDepth="6"
                                                  Opacity="0.32"
                                                  Color="#9F7E69" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BrandHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BrandPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BrandSoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource InkBodyBrush}" />
                                <Setter TargetName="Chrome" Property="Effect" Value="{x:Null}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ ⋯ menu button (60h × 56w, 22r, white) ============ -->
        <Style x:Key="DotsButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBodyBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="60" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BrandSoftBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource StrokeStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BrandSoftBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource StrokeStrongBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Secondary button (popup items) ============ -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkTitleBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BrandSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ============ Window controls (28×28 ghost) ============ -->
        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBodyBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BrandSoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource InkTitleBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hero pill (banner prev/next) -->
        <Style x:Key="HeroPillButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="C"
                                Background="{TemplateBinding Background}"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="C" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Foot toggle: "고급 로그 ▾" -->
        <Style x:Key="FootToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkMuteBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Inter, SF Pro Text, Segoe UI, system-ui" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="C"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="C" Property="Background" Value="{StaticResource BrandSoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource InkBodyBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource InkBodyBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ TextBox / ProgressBar ============ -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkTitleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
            <Setter Property="Background" Value="{StaticResource BrandSoftBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="2"
                                Background="{TemplateBinding Background}"
                                ClipToBounds="True">
                            <Grid>
                                <Rectangle x:Name="PART_Track" />
                                <Rectangle x:Name="PART_Indicator"
                                           Fill="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Left"
                                           RadiusX="2"
                                           RadiusY="2" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ============ OUTER WINDOW SHELL ============ -->
    <Border Margin="14"
            Background="{StaticResource PageBrush}"
            BorderBrush="{StaticResource StrokeBrush}"
            BorderThickness="1"
            CornerRadius="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40"
                              ShadowDepth="14"
                              Opacity="0.18"
                              Color="#483420" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <!-- ===== Title bar (drag area + brand + nav + window controls) ===== -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="24,0,0,0">
                        <Border Width="22" Height="22" CornerRadius="7">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#9F7E69" Offset="0" />
                                    <GradientStop Color="#D2BBA0" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Rectangle Width="8" Height="8" Fill="#FFFFFF"
                                       RadiusX="2" RadiusY="2"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Opacity="0.95" />
                        </Border>
                        <TextBlock Text="DotShelf"
                                   Foreground="{StaticResource InkTitleBrush}"
                                   FontSize="14" FontWeight="Bold"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />

                        <StackPanel Orientation="Horizontal" Margin="32,0,0,0" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="라이브러리"
                                           Foreground="{StaticResource InkTitleBrush}"
                                           FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Border VerticalAlignment="Bottom"
                                        HorizontalAlignment="Center"
                                        Width="18" Height="2"
                                        CornerRadius="1"
                                        Background="{StaticResource BrandBrush}"
                                        Margin="0,0,0,-12" />
                            </Grid>
                            <TextBlock Text="뉴스"
                                       Foreground="{StaticResource InkBodyBrush}"
                                       FontSize="13"
                                       Margin="22,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="설정"
                                       Foreground="{StaticResource InkBodyBrush}"
                                       FontSize="13"
                                       Margin="22,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,20,0"
                                Panel.ZIndex="30">
                        <Button Content="⚙" Style="{StaticResource WindowButtonStyle}" FontSize="14"
                                Margin="0,0,4,0" IsHitTestVisible="False" Opacity="0.6" />
                        <Button Content="─" Style="{StaticResource WindowButtonStyle}" Margin="0,0,4,0"
                                Click="MinimizeButton_Click" />
                        <Button Content="✕" Style="{StaticResource WindowButtonStyle}"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== BODY (sidebar + main + drawer overlay) ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ============ SIDEBAR ============ -->
                <Border Grid.Column="0"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="0,1,1,0">
                    <Grid Margin="16,18,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="라이브러리"
                                   Foreground="{StaticResource InkMuteBrush}"
                                   FontFamily="Inter, SF Pro Text, Segoe UI, system-ui"
                                   FontSize="11" FontWeight="SemiBold"
                                   Margin="8,4,0,12" />

                        <!-- DotShelf row (active) -->
                        <Border Grid.Row="1"
                                Background="{StaticResource BrandSoftBrush}"
                                CornerRadius="12"
                                Padding="8,8,12,8" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="4" Height="24"
                                        CornerRadius="2"
                                        Background="{StaticResource BrandBrush}"
                                        VerticalAlignment="Center" />
                                <Border Grid.Column="1" Width="44" Height="44"
                                        CornerRadius="12" Margin="6,0,0,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#9F7E69" Offset="0" />
                                            <GradientStop Color="#876653" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="D"
                                               Foreground="#FFFFFF"
                                               FontSize="17" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="DotShelf"
                                               Foreground="{StaticResource InkTitleBrush}"
                                               FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="설치 · 업데이트 · 실행"
                                               Foreground="{StaticResource InkMuteBrush}"
                                               FontFamily="Inter, SF Pro Text, Segoe UI, system-ui"
                                               FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Library Studio (dim) -->
                        <Border Grid.Row="2" Background="Transparent"
                                CornerRadius="12" Padding="8,8,12,8" Margin="0,0,0,4"
                                Opacity="0.45">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="1" Width="44" Height="44"
                                        CornerRadius="12" Margin="6,0,0,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#DFD4C6" Offset="0" />
                                            <GradientStop Color="#C8B9A6" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="L"
                                               Foreground="#FFFFFF"
                                               FontSize="17" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Library Studio"
                                               Foreground="{StaticResource InkBodyBrush}"
                                               FontSize="13" />
                                    <TextBlock Text="Coming soon"
                                               Foreground="{StaticResource InkMuteBrush}"
                                               FontFamily="Inter, SF Pro Text, Segoe UI, system-ui"
                                               FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Read Together (dim) -->
                        <Border Grid.Row="3" Background="Transparent"
                                CornerRadius="12" Padding="8,8,12,8" Margin="0,0,0,4"
                                Opacity="0.45">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="1" Width="44" Height="44"
                                        CornerRadius="12" Margin="6,0,0,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#DFD4C6" Offset="0" />
                                            <GradientStop Color="#C8B9A6" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="R"
                                               Foreground="#FFFFFF"
                                               FontSize="17" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Read Together"
                                               Foreground="{StaticResource InkBodyBrush}"
                                               FontSize="13" />
                                    <TextBlock Text="Coming soon"
                                               Foreground="{StaticResource InkMuteBrush}"
                                               FontFamily="Inter, SF Pro Text, Segoe UI, system-ui"
                                               FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Mini-game card — click opens game modal -->
                        <Border Grid.Row="5"
                                x:Name="MiniGameCard"
                                Width="192" Height="92"
                                HorizontalAlignment="Center"
                                BorderBrush="{StaticResource StrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Margin="0,12,0,0"
                                Cursor="Hand"
                                MouseLeftButtonUp="MiniGameCard_MouseLeftButtonUp">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#F4ECE3" Offset="0" />
                                    <GradientStop Color="#FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Margin="14,12,14,12">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="잠깐 한 판"
                                               Foreground="{StaticResource BrandBrush}"
                                               FontFamily="Inter, SF Pro Text, Segoe UI, system-ui"
                                               FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="책 쌓기"
                                               Foreground="{StaticResource InkTitleBrush}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Margin="0,2,0,0" />
                                    <TextBlock Text="대기 중 즐기는 라이트 게임"
                                               Foreground="{StaticResource InkBodyBrush}"
                                               FontSize="11"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom">
                                    <Rectangle Width="14" Height="5" RadiusX="2" RadiusY="2"
                                               Fill="{StaticResource BrandBrush}" Opacity="0.35"
                                               HorizontalAlignment="Center" Margin="0,0,0,2" />
                                    <Rectangle Width="22" Height="5" RadiusX="2" RadiusY="2"
                                               Fill="{StaticResource BrandBrush}" Opacity="0.55"
                                               HorizontalAlignment="Center" Margin="0,0,0,2" />
                                    <Rectangle Width="28" Height="5" RadiusX="2" RadiusY="2"
                                               Fill="{StaticResource BrandBrush}" Opacity="0.75"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ============ MAIN COLUMN ============ -->
                <Grid Grid.Column="1" Margin="28,16,28,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ===== Hero (real banners only) ===== -->
                    <Grid x:Name="HeroSlot" Grid.Row="0" Margin="0,0,0,16">

                        <!-- BannerRow — only hero, real events.json banners -->
                        <Border x:Name="BannerRow"
                                Visibility="Collapsed"
                                Height="200"
                                CornerRadius="22"
                                ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#9F7E69" Offset="0" />
                                    <GradientStop Color="#876653" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <!-- veil overlay — same CornerRadius so it doesn't square the corners -->
                                <Border CornerRadius="22">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                            <GradientStop Color="#8C2A2018" Offset="0" />
                                            <GradientStop Color="#002A2018" Offset="0.6" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <TextBlock Text="image_placeholder · 실 이미지로 교체"
                                           Foreground="#99FFFFFF"
                                           FontFamily="Inter, SF Pro Text, Segoe UI, system-ui"
                                           FontSize="11"
                                           HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Margin="0,16,20,0" />

                                <Border x:Name="BannerClickArea"
                                        Background="Transparent"
                                        MouseLeftButtonUp="BannerClickArea_MouseLeftButtonUp" />

                                <Grid HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                      Margin="28,0,0,28">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <Border x:Name="BannerAccent"
                                                Width="3" Height="20"
                                                CornerRadius="2"
                                                VerticalAlignment="Center"
                                                Margin="0,0,10,0" />
                                        <Border x:Name="BannerChip"
                                                BorderBrush="#80FFFFFF" BorderThickness="1"
                                                CornerRadius="10" Padding="12,5"
                                                VerticalAlignment="Center">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="6" ShadowDepth="2"
                                                                  Opacity="0.25" Color="#000000" />
                                            </Border.Effect>
                                            <TextBlock x:Name="BannerChipText"
                                                       Foreground="#FFFFFF"
                                                       FontSize="11" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="BannerTitle"
                                               Grid.Row="1"
                                               Foreground="#FFFFFF"
                                               FontSize="22" FontWeight="SemiBold"
                                               Margin="0,12,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="560" />
                                </Grid>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="0,0,24,24">
                                    <!-- Dynamic dot indicator (populated by code-behind from activeBanners.Count) -->
                                    <StackPanel x:Name="HeroDotsPanel"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="0,0,12,0" />
                                    <Button x:Name="BannerPrevButton"
                                            Content="‹"
                                            Style="{StaticResource HeroPillButtonStyle}"
                                            Margin="0,0,8,0"
                                            Click="BannerPrevButton_Click" />
                                    <Button x:Name="BannerNextButton"
                                            Content="›"
                                            Style="{StaticResource HeroPillButtonStyle}"
                                            Click="BannerNextButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ===== Meta row + CTA ===== -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="VersionText"
                                           Text="DotShelf"
                                           Foreground="{StaticResource InkTitleBrush}"
                                           FontSize="18" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="PackageSizeText"
                                           Text="설치 파일 크기 확인 중"
                                           Foreground="{StaticResource InkBodyBrush}"
                                           FontFamily="Inter, SF Pro Text, Segoe UI, system-ui"
                                           FontSize="13"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   x:Name="StatusText"
                                   Text="최신 빌드 정보를 확인하는 중입니다."
                                   Foreground="{StaticResource InkBodyBrush}"
                                   FontSize="13"
                                   Margin="0,4,0,14" />

                        <!-- Error alert (visible only on Error state) -->
                        <Border x:Name="ErrorAlert"
                                Grid.Row="2"
                                Visibility="Collapsed"
                                Background="#14C26B57"
                                BorderBrush="#3DC26B57"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12,10"
                                Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource DangerBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="ErrorAlertText"
                                           Text="오류가 발생했습니다"
                                           Foreground="#8C3E2C"
                                           FontSize="13"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- CTA row -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal">
                            <Grid>
                                <Button x:Name="ActionButton"
                                        Content="설치하기"
                                        Style="{StaticResource BigCtaButtonStyle}"
                                        Click="ActionButton_Click" />
                                <Button x:Name="LaunchButton"
                                        Content="▶  시작하기"
                                        Style="{StaticResource BigCtaButtonStyle}"
                                        Visibility="Collapsed"
                                        Click="LaunchButton_Click" />

                                <!-- Running indicator: looks like a disabled CTA with live dot -->
                                <Border x:Name="RunningIndicator"
                                        Visibility="Collapsed"
                                        Background="{StaticResource BrandSoftBrush}"
                                        CornerRadius="22"
                                        Height="60" MinWidth="280"
                                        Padding="24,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Grid Width="10" Height="10" VerticalAlignment="Center">
                                            <Ellipse Fill="#5C9F6F" />
                                            <Ellipse Fill="#5C9F6F" Opacity="0.35">
                                                <Ellipse.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1" CenterX="5" CenterY="5" />
                                                </Ellipse.RenderTransform>
                                                <Ellipse.Triggers>
                                                    <EventTrigger RoutedEvent="Ellipse.Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                 From="1" To="2.4" Duration="0:0:1.4"
                                                                                 AutoReverse="True" />
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                 From="1" To="2.4" Duration="0:0:1.4"
                                                                                 AutoReverse="True" />
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="0.45" To="0" Duration="0:0:1.4"
                                                                                 AutoReverse="True" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Ellipse.Triggers>
                                            </Ellipse>
                                        </Grid>
                                        <TextBlock Text="DotShelf 실행 중"
                                                   Foreground="{StaticResource InkBodyBrush}"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Margin="14,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <ToggleButton x:Name="MoreMenuToggle"
                                          Content="⋯"
                                          Style="{StaticResource DotsButtonStyle}"
                                          Margin="12,0,0,0" />
                            <Popup PlacementTarget="{Binding ElementName=MoreMenuToggle}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   IsOpen="{Binding IsChecked, ElementName=MoreMenuToggle, Mode=TwoWay}"
                                   HorizontalOffset="-160" VerticalOffset="6">
                                <Border Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource StrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="6"
                                        MinWidth="220">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="24"
                                                          ShadowDepth="8"
                                                          Opacity="0.18"
                                                          Color="#483420" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <Button x:Name="ChooseInstallLocationButton"
                                                Content="설치 위치 변경"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="ChooseInstallLocationButton_Click" />
                                        <Button x:Name="DeleteButton"
                                                Content="삭제"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Foreground="{StaticResource DangerBrush}"
                                                Click="DeleteButton_Click" />
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <!-- State-specific caption / link to the right of CTA -->
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="20,0,0,0">
                                <TextBlock x:Name="CtaCaption"
                                           Text=""
                                           Foreground="{StaticResource InkMuteBrush}"
                                           FontFamily="Inter, SF Pro Text, Segoe UI, system-ui"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="KeepCurrentLink"
                                           Visibility="Collapsed"
                                           Text="이번 버전 그대로 실행"
                                           Foreground="{StaticResource BrandHoverBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="14,0,0,0"
                                           TextDecorations="Underline"
                                           Cursor="Hand"
                                           MouseLeftButtonUp="KeepCurrentLink_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- ===== 3 News cards ===== -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource StrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="14,12"
                                MinHeight="108">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.05" Color="#483420" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Border Background="{StaticResource SuccessBrush}"
                                            CornerRadius="10" Padding="8,3">
                                        <TextBlock Text="업데이트"
                                                   Foreground="#FFFFFF"
                                                   FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Row="1"
                                           Text="v1.4.2 패치노트"
                                           Foreground="{StaticResource InkTitleBrush}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Margin="0,10,0,0" />
                                <TextBlock Grid.Row="2"
                                           Text="책장 정렬 안정화, 메모리 사용량 18% 감소"
                                           Foreground="{StaticResource InkBodyBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" LineHeight="18"
                                           Margin="0,4,0,0" />
                                <TextBlock Grid.Row="3"
                                           Text="2일 전"
                                           Foreground="{StaticResource InkMuteBrush}"
                                           FontFamily="Inter, SF Pro Text, Segoe UI, system-ui"
                                           FontSize="11"
                                           Margin="0,8,0,0" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource StrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="14,12"
                                MinHeight="108">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.05" Color="#483420" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Border Background="{StaticResource NoticeBrush}"
                                            CornerRadius="10" Padding="8,3">
                                        <TextBlock Text="공지"
                                                   Foreground="#FFFFFF"
                                                   FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Row="1"
                                           Text="점검 안내"
                                           Foreground="{StaticResource InkTitleBrush}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Margin="0,10,0,0" />
                                <TextBlock Grid.Row="2"
                                           Text="5월 11일 03:00–05:00 KST 서버 점검"
                                           Foreground="{StaticResource InkBodyBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" LineHeight="18"
                                           Margin="0,4,0,0" />
                                <TextBlock Grid.Row="3"
                                           Text="예정"
                                           Foreground="{StaticResource InkMuteBrush}"
                                           FontFamily="Inter, SF Pro Text, Segoe UI, system-ui"
                                           FontSize="11"
                                           Margin="0,8,0,0" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="4"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource StrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="14,12"
                                MinHeight="108">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.05" Color="#483420" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Border Background="{StaticResource WarningBrush}"
                                            CornerRadius="10" Padding="8,3">
                                        <TextBlock Text="콜라보"
                                                   Foreground="#2A2018"
                                                   FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Row="1"
                                           Text="독립서점 큐레이션"
                                           Foreground="{StaticResource InkTitleBrush}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Margin="0,10,0,0" />
                                <TextBlock Grid.Row="2"
                                           Text="전국 12개 서점이 고른 5월의 책"
                                           Foreground="{StaticResource InkBodyBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" LineHeight="18"
                                           Margin="0,4,0,0" />
                                <TextBlock Grid.Row="3"
                                           Text="D-3"
                                           Foreground="{StaticResource InkMuteBrush}"
                                           FontFamily="Inter, SF Pro Text, Segoe UI, system-ui"
                                           FontSize="11"
                                           Margin="0,8,0,0" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== Drawer overlay (slides over main column when toggled) ===== -->
                <Border Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="0,1,0,0"
                        Height="320"
                        Panel.ZIndex="50">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=LogDrawerToggle}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="-6" Opacity="0.10" Color="#483420" />
                    </Border.Effect>
                    <Grid Margin="28,16,28,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="고급 로그"
                                           Foreground="{StaticResource InkTitleBrush}"
                                           FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="다운로드 · 검증 · 압축 해제 · 설치 결과"
                                           Foreground="{StaticResource InkMuteBrush}"
                                           FontSize="11"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <TextBox Grid.Row="1"
                                 x:Name="LogTextBox"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 FontFamily="JetBrains Mono, D2Coding, Consolas, Malgun Gothic"
                                 FontSize="12"
                                 Background="{StaticResource SunkenBrush}"
                                 Foreground="{StaticResource InkBodyBrush}"
                                 BorderBrush="{StaticResource StrokeBrush}"
                                 BorderThickness="1"
                                 Padding="12,10" />
                    </Grid>
                </Border>

                <!-- ===== Hidden state holders (Visibility=Collapsed; only score/path/progress) ===== -->
                <Grid Grid.Column="1" Visibility="Collapsed">
                    <TextBlock x:Name="GameScoreText" Text="0" />
                    <TextBlock x:Name="GameBestScoreText" Text="0" />
                    <TextBlock x:Name="InstallPathText" Text="" />
                    <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" />
                </Grid>
            </Grid>

            <!-- ===== FOOT (caption + drawer toggle) ===== -->
            <Border Grid.Row="2"
                    BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="0,1,0,0"
                    Background="{StaticResource PageBrush}">
                <Grid Margin="28,0,28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="설치 위치는 ⋯ 메뉴에서 변경할 수 있어요"
                               Foreground="{StaticResource InkMuteBrush}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                    <ToggleButton Grid.Column="1"
                                  x:Name="LogDrawerToggle"
                                  Style="{StaticResource FootToggleStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="고급 로그" VerticalAlignment="Center" />
                            <TextBlock x:Name="LogDrawerCaret"
                                       Text=" ▾"
                                       VerticalAlignment="Center"
                                       Margin="2,0,0,0" />
                        </StackPanel>
                        <ToggleButton.Triggers>
                            <EventTrigger RoutedEvent="ToggleButton.Checked">
                                <BeginStoryboard>
                                    <Storyboard />
                                </BeginStoryboard>
                            </EventTrigger>
                        </ToggleButton.Triggers>
                    </ToggleButton>
                </Grid>
            </Border>

            <!-- ===== Game modal overlay ===== -->
            <Grid x:Name="GameModal"
                  Grid.RowSpan="3"
                  Visibility="Collapsed"
                  Panel.ZIndex="100">
                <Border Background="#80000000"
                        MouseLeftButtonUp="GameModalBackdrop_MouseLeftButtonUp" />
                <Border Width="540" Height="540"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource PageBrush}"
                        BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="22">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="14" Opacity="0.30" Color="#483420" />
                    </Border.Effect>
                    <Grid Margin="24,20,24,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="잠깐 한 판"
                                           Foreground="{StaticResource BrandBrush}"
                                           FontFamily="Inter, SF Pro Text, Segoe UI, system-ui"
                                           FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="책 쌓기"
                                           Foreground="{StaticResource InkTitleBrush}"
                                           FontSize="20" FontWeight="SemiBold"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{StaticResource BrandSoftBrush}"
                                        CornerRadius="12" Padding="12,6"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ElementName=GameScoreText, Path=Text}"
                                                   Foreground="{StaticResource InkTitleBrush}"
                                                   FontFamily="Inter, SF Pro Text, Segoe UI, system-ui"
                                                   FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="  /  "
                                                   Foreground="{StaticResource InkMuteBrush}"
                                                   FontFamily="Inter, SF Pro Text, Segoe UI, system-ui"
                                                   FontSize="13" />
                                        <TextBlock Text="{Binding ElementName=GameBestScoreText, Path=Text}"
                                                   Foreground="{StaticResource InkMuteBrush}"
                                                   FontFamily="Inter, SF Pro Text, Segoe UI, system-ui"
                                                   FontSize="14" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Button x:Name="CloseGameButton"
                                        Content="✕"
                                        Style="{StaticResource WindowButtonStyle}"
                                        Width="32" Height="32"
                                        Click="CloseGameButton_Click" />
                            </StackPanel>
                        </Grid>

                        <!-- Canvas area -->
                        <Border Grid.Row="1"
                                Background="{StaticResource SunkenBrush}"
                                BorderBrush="{StaticResource StrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                ClipToBounds="True">
                            <Grid>
                                <Canvas x:Name="GameCanvas"
                                        Background="{StaticResource SunkenBrush}"
                                        ClipToBounds="True"
                                        Focusable="True"
                                        MouseLeftButtonDown="GameCanvas_MouseLeftButtonDown" />
                                <Border x:Name="GameOverlay"
                                        Background="#F0FAF5EF"
                                        Padding="28">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="GameOverlayTitle"
                                                   Text="하늘책 수집"
                                                   Foreground="{StaticResource InkTitleBrush}"
                                                   FontSize="22" FontWeight="SemiBold"
                                                   TextAlignment="Center" />
                                        <TextBlock x:Name="GameOverlayDescription"
                                                   Text="책을 받으면 점수가 오르고, 어두운 장애물에 닿으면 게임이 끝납니다."
                                                   Foreground="{StaticResource InkBodyBrush}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   LineHeight="20"
                                                   Margin="0,12,0,12" />
                                        <TextBlock x:Name="GameOverlayInstruction"
                                                   Text="← / → 방향키로 이동"
                                                   Foreground="{StaticResource InkBodyBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   Margin="0,0,0,18" />
                                        <Button x:Name="StartGameButton"
                                                Content="시작하기"
                                                Style="{StaticResource BigCtaButtonStyle}"
                                                Width="140" MinWidth="140" Height="44"
                                                HorizontalAlignment="Center"
                                                FontSize="14"
                                                Click="StartGameButton_Click" />
                                        <Button x:Name="RetryGameButton"
                                                Content="다시하기"
                                                Style="{StaticResource BigCtaButtonStyle}"
                                                Width="140" MinWidth="140" Height="44"
                                                HorizontalAlignment="Center"
                                                FontSize="14"
                                                Visibility="Collapsed"
                                                Click="RetryGameButton_Click" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
